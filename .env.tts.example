# Copy into .env.local. Server-only: NEVER prefix these with NEXT_PUBLIC_.
# Enable Cloud Text-to-Speech API and billing in this Google Cloud project.
GOOGLE_TTS_PROJECT_ID=your-google-cloud-project-id
GOOGLE_TTS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_TTS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Alternative to CLIENT_EMAIL / PRIVATE_KEY: an absolute service account JSON path.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/google-tts-service-account.json
# Or use Application Default Credentials on Google Cloud (no private key required):
# GOOGLE_TTS_USE_ADC=true

# Uses the existing R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
# R2_BUCKET and R2_PUBLIC_BASE_URL to store generated MP3 files.
