{
  "name": "vo-danh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "dev:webpack": "next dev --webpack --port 3001",
    "build": "next build && node scripts/pwa-assets.mjs",
    "start": "next start",
    "lint": "eslint",
    "knowledge:extract": "node scripts/knowledge/extract-runner.mjs",
    "knowledge:drafts": "tsx scripts/generate-drafts.ts",
    "knowledge:validate": "tsx scripts/validate-knowledge.ts",
    "knowledge:import": "node --conditions=react-server --import tsx scripts/import-knowledge.ts",
    "knowledge:test": "node --test tests/knowledge.test.mjs",
    "knowledge:dialogue-drafts": "tsx scripts/revise-character-drafts.ts",
    "chat:test": "node --test tests/chat.test.mjs tests/chat-repositories.test.mjs tests/chat-dialogue.test.mjs",
    "knowledge:import:phase3": "node --conditions=react-server --import tsx scripts/import-knowledge.ts --file knowledge/draft-questions-phase-2-v3.json --required-version 3 --report knowledge/import-report-phase-3.json",
    "knowledge:admin:test": "node --test tests/knowledge-admin.test.mjs tests/knowledge-admin-mongo.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@google/genai": "^2.30.0",
    "@payos/node": "^2.0.5",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.5.0",
    "google-auth-library": "^11.3.0",
    "jsqr": "^1.4.0",
    "mongodb": "^6.21.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.15",
    "pdfjs-dist": "^4.8.69",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
