# Existing application settings
NEXT_PUBLIC_APP_URL=http://localhost:3001

# MongoDB: uses this database name, or the database in MONGODB_URI if omitted.
MONGODB_URI=
MONGODB_DB_NAME=vo_danh

# Admin is provisioned on successful email/password login (password: 6-32 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password reset email. "preview" stores mail under .local/mail in development only.
# Use "smtp" and set the fields below when email delivery is ready.
MAIL_TRANSPORT=preview
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional server-only override for password reset URLs.
APP_URL=http://localhost:3001

# Cloudflare R2 for character images (server-only uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Set the product price in Admin > Thiet lap. Pricing is stored in MongoDB.

# payOS merchant channel credentials (server-only).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Register https://your-domain/api/payos/webhook in your payOS channel.
# APP_URL must be the public HTTPS origin in production.
